# NetRadar fusion center configuration — generated by ./setup.sh.
# Do not edit by hand unless you know why; never commit the real .env.

# Address the broker (1883) and dashboard (5002) listen on: this machine's
# Tailscale IPv4 (`tailscale ip -4`).
NETRADAR_BIND_IP=<tailscale-ip-of-this-machine>
# Name/IP the radar nodes use to reach this machine (Tailscale MagicDNS name).
NETRADAR_FC_HOST=<fusion-center-host>
NETRADAR_NODES=node1,node2,node3
NETRADAR_TOPIC_PREFIX=netradar/v1

POSTGRES_USER=netradar
POSTGRES_DB=netradar
POSTGRES_PASSWORD=<generated-by-setup.sh>

MQTT_SERVER_USER=server
MQTT_SERVER_PASS=<generated-by-setup.sh>
